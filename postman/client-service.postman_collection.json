{
  "info": {
    "_postman_id": "a8f3c5c2-135e-4515-91d8-client-service",
    "name": "Client Service",
    "description": "Operaciones para registrar y consultar clientes pagadores.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "clientBaseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "clientId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Create client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Ana López\",\n  \"email\": \"ana@example.com\"\n}"
        },
        "url": "{{clientBaseUrl}}/api/v1/clients"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('clientId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get client by ID",
      "request": {
        "method": "GET",
        "url": "{{clientBaseUrl}}/api/v1/clients/{{clientId}}"
      }
    },
    {
      "name": "List clients",
      "request": {
        "method": "GET",
        "url": "{{clientBaseUrl}}/api/v1/clients"
      }
    }
  ]
}
